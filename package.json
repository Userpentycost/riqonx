{
  "name": "riqonx",
  "version": "1.0.0",
  "description": "AI-powered YouTube channel analyzer - analyze winning channels, generate original content",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --exec babel-node server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "babel server -d dist",
    "build:client": "cd client && npm run build",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "mongoose": "^8.0.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "openai": "^4.16.1",
    "youtube-transcript-api": "^0.4.12",
    "redis": "^4.6.11",
    "bull": "^4.11.5",
    "socket.io": "^4.7.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/node": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "eslint": "^8.54.0"
  }
}
